[Unit]
# Never stop retrying: RestartSec= already spaces restarts out, and the
# watchdog's own `systemctl restart` would be refused once a start limit trips.
# (Start-limit keys belong in [Unit]; in [Service] systemd ignores them.)
StartLimitIntervalSec=0
Description=Stick Fight lobby control plane (list / create / stop + reaper)
Documentation=https://github.com/milescoviello/sf-multiplayer
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=miles
Group=miles
WorkingDirectory=/home/miles/sf-multiplayer

# Secret token for create/stop (POST). Lives outside git; '-' = optional so a
# fresh checkout without the file still starts (create just stays token-gated).
EnvironmentFile=-/home/miles/sf-oracle/sf-control.env
Environment=SF_LOBBIES_DIR=/tmp/sf-lobbies
# Cap on live lobbies (static ones count). The port search span is separate
# (launch-lobby.sh SF_PORT_SPAN, default 24 → 1337-1360).
Environment=SF_MAX_LOBBIES=8
Environment=SF_ROUTER_STATS=http://127.0.0.1:8081/router/stats
# Unbuffer so reaper/create log lines reach the journal immediately.
Environment=PYTHONUNBUFFERED=1
# Empty-lobby reaper TTL for CREATED lobbies (static ones are never reaped).
# 300 s was too aggressive for someone who steps away; 24 h kept a lobby made in
# the morning alive all day, and those leftovers used up the ports. 30 min.
Environment=SF_LOBBY_EMPTY_TTL=1800

ExecStart=/usr/bin/python3 /home/miles/sf-multiplayer/serve-lobbies.py --host 0.0.0.0 --port 8080

# CRITICAL: this service SPAWNS lobby backends (launch-lobby.sh). KillMode=process
# kills only the python main process on stop/restart, leaving running lobbies
# alive — the control plane is just an API; lobbies outlive it.
KillMode=process
Restart=on-failure
RestartSec=3

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
