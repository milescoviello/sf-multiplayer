<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net35</TargetFramework>
    <AssemblyName>SFOnlinePatcher</AssemblyName>
    <RootNamespace>SFOnlinePatcher</RootNamespace>
    <LangVersion>9.0</LangVersion>
    <NoWarn>CS0436;CS1591;CS0649</NoWarn>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\shared\Mono2Polyfills.cs" Link="Mono2Polyfills.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- From BepInEx 5.4 core (gitignored refs/): the patcher runs inside BepInEx's preloader. -->
    <Reference Include="BepInEx"><HintPath>refs\BepInEx.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="Mono.Cecil"><HintPath>refs\Mono.Cecil.dll</HintPath><Private>False</Private></Reference>
  </ItemGroup>
</Project>
